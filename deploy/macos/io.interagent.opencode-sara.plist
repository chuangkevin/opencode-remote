<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.interagent.opencode-sara</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/kevin/.local/share/opencode-remote/run-opencode-sara.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/kevin/.local/share/opencode-remote</string>

  <key>RunAtLoad</key>
