{
    email {$ACME_EMAIL}
}

(proxy_common) {
    header_up -Accept-Encoding
    flush_interval -1
    transport http {
        compression off
    }
}

*.sisihome.org {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    @portainer host portainer.sisihome.org
    handle @portainer {
        reverse_proxy portainer:9000 {
            import proxy_common
        }
    }

    @onshape host onshape.sisihome.org
    handle @onshape {
        reverse_proxy 100.79.242.43:6123 {
            import proxy_common
        }
    }

    @mita host mita.sisihome.org
    handle @mita {
        reverse_proxy 100.73.52.37:5325 {
