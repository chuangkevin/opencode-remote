# Required: absolute path to the directory OpenCode should work in
# If .env is missing or this value is unknown, run .\setup-capabilities.ps1.
OPENCODE_DIRECTORY=D:\Projects\_HomeProject

# Optional (defaults shown)
PORT=9223
BIND_ADDRESS=0.0.0.0
OPENCODE_PORT=4096
SESSION_REFRESH_INTERVAL_MS=30000

# Optional: override when opencode-cli.exe is installed in a non-standard path
# Windows default lookup: %LOCALAPPDATA%\opencode\opencode-cli.exe
OPENCODE_CLI_PATH=

# Optional: local-only token used by the GitHub MCP server in opencode.json
# Do not commit a real token. Keep the real value in .env only.
GITHUB_TOKEN=
